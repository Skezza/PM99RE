# Local PM99 and emulator assets. These can contain proprietary game, Windows,
# Wine, BIOS, disk image, or generated runtime state and must stay untracked.
assets/*
!assets/README.md
vendor/*
!vendor/README.md

# Browser/runtime outputs.
*.img
*.iso
*.zip
*.wasm
*.data
*.sav
*.state
*.mem
*.log
*.cache
*.tmp
playwright-report/
test-results/

# Local backend configs may include private image names or paths.
config/*.local.json
