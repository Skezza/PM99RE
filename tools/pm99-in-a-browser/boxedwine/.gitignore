# Local-only runtime assets. Do not commit BoxedWine builds, Wine filesystems,
# PM99 binaries, generated app bundles, or browser persistence exports.
vendor/*
assets/rootfs/*
assets/apps/*
assets/overlays/*
local/*
*.log

!vendor/.gitkeep
!assets/rootfs/.gitkeep
!assets/apps/.gitkeep
!assets/overlays/.gitkeep
