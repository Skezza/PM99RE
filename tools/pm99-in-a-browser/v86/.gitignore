# Local v86 runtime/vendor drops. Keep the scaffold, ignore runnable payloads.
/vendor/*
!/vendor/README.md

# Local guest assets. These may include Windows and PM99 media and must stay out
# of PM99RE history.
/assets/bios/*
!/assets/bios/README.md
/assets/disks/*
!/assets/disks/README.md
/assets/media/*
!/assets/media/README.md

# Common emulator image/archive formats not covered by the root PM99 rules.
*.bin
*.rom
*.img
*.ima
*.iso
*.vhd
*.vhdx
*.vmdk
*.qcow2
*.raw
*.fd
*.zst
*.zip
*.7z
*.rar
